# ---- 运行环境 ----
ARTILENS_ENV=local
ARTILENS_DEBUG=true
ARTILENS_LOG_JSON=false

# ---- 存储 ----
# 上传的 PDF、解析产物、SQLite、向量库都落在这里（已在 .gitignore 中忽略）
ARTILENS_DATA_DIR=./data
# 本地：SQLite；目标态换成 Postgres，只改这一行
ARTILENS_DATABASE_URL=sqlite+aiosqlite:///./data/artilens.db

# ---- 大模型（DashScope 的 OpenAI 兼容端点）----
ARTILENS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARTILENS_LLM_API_KEY=
ARTILENS_LLM_MODEL=qwen-plus
ARTILENS_LLM_TIMEOUT_S=120

# ---- 向量 ----
ARTILENS_VECTOR_BACKEND=lance
ARTILENS_EMBEDDING_MODEL=text-embedding-v4
ARTILENS_EMBEDDING_DIM=1024

# ---- 上传 ----
ARTILENS_UPLOAD_MAX_MB=50

# ---- CORS（前端 dev server）----
ARTILENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
